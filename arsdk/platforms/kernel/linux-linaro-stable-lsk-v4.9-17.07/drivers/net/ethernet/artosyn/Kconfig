config SIRIUS_ETH
	tristate "Sirius Ethernet support"
	select CRC32
	select MII
	select PHYLIB
	default y

config SIRIUS_ETH_BASIC_FEATURES
	bool "Disable Gigabit Ethernet Features"
	depends on SIRIUS_ETH
	---help---
	  Do not advertise 1000BT capabilities during auto negotiation process,
	  even if supported by ethernet core.
