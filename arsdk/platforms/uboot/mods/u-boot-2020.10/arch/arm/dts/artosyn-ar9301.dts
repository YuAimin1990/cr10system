/dts-v1/;

#include "artosyn-ar9301.dtsi"

//#if gCONFIG_ARTOSYN_SIRIUS_DDR_TYPE==ddr3
//#include "artosyn-sirius-ddr3.dtsi"
//#elif gCONFIG_ARTOSYN_SIRIUS_DDR_TYPE==ddr4
//#include "artosyn-sirius-ddr4.dtsi"
//#elif gCONFIG_ARTOSYN_SIRIUS_DDR_TYPE==lpddr3
//#include "artosyn-sirius-lpddr3.dtsi"
//#endif

/ {
	model = "Artosyn Sirius demo board";
	compatible = "artosyn, sirius-demo";

	aliases {
		console = &uart0;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

};

&uart0 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&emmc {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&sdmmc {
	max-frequency = <10000000>;
	fifo-depth = <128>;
	bus-width = <4>;
	status = "okay";
};

&enet0 {
	status = "okay";
};

&usb_otg0 {
	vbus-supply = <&vbus_regulator0>;
	dr_mode = "host";
	status = "okay";
};

&usb_device0 {
	status = "okay";
};

&usb_otg1 {
	vbus-supply = <&vbus_regulator1>;
	dr_mode = "host";
	status = "okay";
};

&usb_device1 {
	status = "okay";
};

&usb_otg2 {
	vbus-supply = <&vbus_regulator2>;
	dr_mode = "host";
	status = "okay";
};

&usb_device2 {
	status = "okay";
};

&qspi {
	u-boot,dm-pre-reloc;
	status = "okay";

	flash@0 {
		u-boot,dm-pre-reloc;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <100000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@1 {
		u-boot,dm-pre-reloc;
		compatible = "jedec,spi-nor";
		reg = <1>;
		spi-max-frequency = <200000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};

	flash@2 {
		u-boot,dm-pre-reloc;
		compatible = "spi-nand";
		reg = <2>;
		spi-max-frequency = <100000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&wdt0 {
	u-boot,dm-pre-reloc;
	status = "okay";
};

&spi0 {
        status = "okay";
};

&spi1 {
        status = "okay";
};

&i2c0 {
        status = "okay";
};

&i2c1 {
        status = "okay";
};

&i2c2 {
        status = "okay";
};

&i2c3 {
        status = "okay";
};

&i2c4 {
        status = "okay";
};
