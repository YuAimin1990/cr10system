if ARCH_ARTOSYN

config ARTOSYN_AR9301
	bool "Support Artosyn 9301"
	select ARM64
	select SUPPORT_SPL
	select SPL
	imply SPL_SEPARATE_BSS
	select SPL_SERIAL_SUPPORT
	select DEBUG_UART_BOARD_INIT
	help
	  The Artosyn 9301 is a ARM-based SoC with a quad-core Cortex-A53
	  including NEON several DDR4 options
	  and video codec support. Peripherals include Gigabit Ethernet,
	  USB2 host and OTG, SDIO, I2S, UART, SPI, I2C and PWMs.

config ARTOSYN_AR9311
	bool "Support Artosyn 9311"
	select ARM64
	select SUPPORT_SPL
	select SPL
	imply SPL_SEPARATE_BSS
	select SPL_SERIAL_SUPPORT
	select DEBUG_UART_BOARD_INIT
	help
	  The Artosyn 9311 is a ARM-based SoC with a dual-core Cortex-A53
	  including NEON several DDR4 options
	  and video codec support. Peripherals include Gigabit Ethernet,
	  USB2 host and OTG, SDIO, I2S, UART, SPI, I2C and PWMs.

config SYS_VENDOR
	default "artosyn"

source arch/arm/mach-artosyn/ar9301/Kconfig
source arch/arm/mach-artosyn/ar9311/Kconfig

endif
