################# select sensor type for your sample ###############################
####    SONY_IMX290_MIPI_2M_30FPS_12BIT            #################
####    SONY_IMX290_SLAVE_MIPI_2M_60FPS_10BIT      #################
####    SONY_IMX334_MIPI_8M_30FPS_12BIT            #################
####    NVP6324_MIPI_2M_30FPS_8BIT                 #################

SENSOR0_TYPE ?= SONY_IMX290_MIPI_2M_30FPS_12BIT
SENSOR1_TYPE ?= ISP_VIN_0_MEM_2M_30FPS_12BIT
SENSOR2_TYPE ?= SONY_IMX290_SLAVE_MIPI_2M_60FPS_10BIT
SENSOR3_TYPE ?= SONY_IMX290_SLAVE_MIPI_2M_60FPS_10BIT
SENSOR4_TYPE ?= SONY_IMX334_MIPI_8M_30FPS_12BIT
SENSOR5_TYPE ?= TP9930_DVP_SINGLE_CH
SENSOR6_TYPE ?= TP9930_DVP_MULTIPLEX_2CH
SENSOR7_TYPE ?= SONY_IMX415_MIPI_8M_30FPS_12BIT
SENSOR8_TYPE ?= SONY_IMX415_MIPI_8M_60FPS_12BIT
SENSOR9_TYPE ?= SONY_IMX290_MIPI_2M_30FPS_12BIT_WDR2TO1
SENSOR10_TYPE ?= SONY_IMX464_MIPI_4M_30FPS_12BIT_WDR2TO1
SENSOR11_TYPE ?= TP9930_DVP_MULTIPLEX_4CH
SENSOR12_TYPE ?= SONY_IMX307_MIPI_2M_25FPS_12BIT_YUV420_SP

SENSOR13_TYPE ?= OV_OS04A10_MIPI_4M_30FPS_12BIT
SENSOR14_TYPE ?= OV_OS04A10_MIPI_4M_30FPS_10BIT_WDR2TO1
SENSOR15_TYPE ?= SONY_IMX464_MIPI_4M_30FPS_10BIT
SENSOR16_TYPE ?= ISP_VIN_0_MEM_2M_30FPS_12BIT_BIG_PIC
SENSOR17_TYPE ?= ISP_VIN_0_MEM_48M_5FPS_12BIT_BIG_PIC
SENSOR18_TYPE ?= OV_OV48C40_MIPI_48M_5FPS_12BIT_BIG_PIC
SENSOR19_TYPE ?= SONY_IMX290_MIPI_2M_30FPS_12BIT_BIG_PIC
SENSOR20_TYPE ?= SONY_IMX464_MIPI_4M_30FPS_12BIT_WDR2TO1_VC_RAW
SENSOR21_TYPE ?= ISP_VIN_0_MEM_2M_30FPS_12BIT_WDR2TO1_LINE_BIG_PIC
SENSOR22_TYPE ?= ISP_VIN_0_MEM_2M_30FPS_12BIT_WDR2TO1_LINE_BIG_PIC_R
SENSOR23_TYPE ?= SONY_IMX290_MIPI_2M_30FPS_12BIT_WDR2TO1_BIG_PIC
SENSOR24_TYPE ?= SONY_IMX347_MIPI_4M_25FPS_12BIT
SENSOR25_TYPE ?= SONY_IMX415_MIPI_HIGH_SPEED_12BIT
SENSOR26_TYPE ?= SONY_IMX415_MIPI_WDR2TO1_VC_12BIT
SENSOR27_TYPE ?= OB_PLECO_MIPI_1920x2880_30FPS_10BIT
SENSOR28_TYPE ?= SONY_IMX290_MIPI_2M_30FPS_12BIT_VC_RAW

CFLAGS += -DSENSOR0_TYPE=$(SENSOR0_TYPE)
CFLAGS += -DSENSOR1_TYPE=$(SENSOR1_TYPE)
CFLAGS += -DSENSOR2_TYPE=$(SENSOR2_TYPE)
CFLAGS += -DSENSOR3_TYPE=$(SENSOR3_TYPE)
CFLAGS += -DSENSOR4_TYPE=$(SENSOR4_TYPE)
CFLAGS += -DSENSOR5_TYPE=$(SENSOR5_TYPE)
CFLAGS += -DSENSOR6_TYPE=$(SENSOR6_TYPE)
CFLAGS += -DSENSOR7_TYPE=$(SENSOR7_TYPE)
CFLAGS += -DSENSOR8_TYPE=$(SENSOR8_TYPE)
CFLAGS += -DSENSOR9_TYPE=$(SENSOR9_TYPE)
CFLAGS += -DSENSOR10_TYPE=$(SENSOR10_TYPE)
CFLAGS += -DSENSOR12_TYPE=$(SENSOR12_TYPE)
CFLAGS += -DSENSOR13_TYPE=$(SENSOR13_TYPE)
CFLAGS += -DSENSOR14_TYPE=$(SENSOR14_TYPE)
CFLAGS += -DSENSOR15_TYPE=$(SENSOR15_TYPE)
CFLAGS += -DSENSOR16_TYPE=$(SENSOR16_TYPE)
CFLAGS += -DSENSOR17_TYPE=$(SENSOR17_TYPE)
CFLAGS += -DSENSOR18_TYPE=$(SENSOR18_TYPE)
CFLAGS += -DSENSOR19_TYPE=$(SENSOR19_TYPE)
CFLAGS += -DSENSOR20_TYPE=$(SENSOR20_TYPE)
CFLAGS += -DSENSOR21_TYPE=$(SENSOR21_TYPE)
CFLAGS += -DSENSOR22_TYPE=$(SENSOR22_TYPE)
CFLAGS += -DSENSOR23_TYPE=$(SENSOR23_TYPE)
CFLAGS += -DSENSOR24_TYPE=$(SENSOR24_TYPE)
CFLAGS += -DSENSOR25_TYPE=$(SENSOR25_TYPE)
CFLAGS += -DSENSOR26_TYPE=$(SENSOR26_TYPE)
CFLAGS += -DSENSOR27_TYPE=$(SENSOR27_TYPE)
CFLAGS += -DSENSOR28_TYPE=$(SENSOR28_TYPE)

ifeq ($(BASE_BOARD), evb)
	CFLAGS += -D USE_EVB
else ifeq ($(BASE_BOARD), evbext)
	CFLAGS += -D USE_EVB_EXT
endif

CFLAGS  += -I$(OUTPUT_APPLICATION_HEADER_DIR)
ifeq ($(CONFIG_BIT), 32bits)
CFLAGS  += -D_FILE_OFFSET_BITS=64
endif
LDFLAGS += -Wl,-rpath-link=$(OUTPUT_APPLICATION_LIB_DIR) -lswresample -lavutil -lavcodec -lavformat

LDFLAGS += -losal -lutils -lm -lhal_dbglog -lhal_ge2d -lhal_vb -lhal_sys -lhal_vdec -lhal_venc -lhal_vin -lhal_vo -lhal_aio -lhal_gpio -lhal_i2c -lhal_region -lhal_clk -lhal_scaler -lhal_gdc -lhal_npu -lhal_dsp -lhal_vgs -lbinder_ipc -lhal_proc -lhal_adec -lhal_aenc
LDFLAGS += -lmpi_dbglog -lmpi_vin -lmpi_vo -lmpi_vb -lmpi_vdec -lmpi_venc -lmpi_vpss -lmpi_sys -lmpi_hdmi -lmpi_region -lmpi_scaler -lmpi_gdc -lmpi_ifc -lmpi_ai -lmpi_ao -lmpi_vgs -lmpi_adec -lmpi_aenc -lmpi_acodec
LDFLAGS += -L$(OUTPUT_APPLICATION_LIB_DIR) -lsns_imx290 -lsns_isp_in_0 -lcjson_utils -lsns_imx290_1 -lsns_tp9930 -lsns_imx415 -lsns_imx464 -lsns_os04a10 -lsns_gc2093  -lsns_sc530ai -lsns_isp_in_l -lsns_isp_in_r -lsns_microiii -lpn_tp2803 -lsns_imx347 -lsns_sc2210 -lsns_os05a20 -lsns_pleco -lsns_gc2053 -ldvp_rx_color_bar -lite66021

ifeq ($(CONFIG_FEAT_EIS),y)
LDFLAGS += -lhal_eis -lmpi_eis
endif

LDFLAGS += -lsns_s5kgn2sp -lsns_gst417w -lsns_h3812c1sg -lsns_rtd6122c -lsns_rtd3172c -lsns_gst412c -lsns_gst612c -lsns_gst212w4 -lsns_isp_in_inf_thermal -lsns_isp_in_inf -lsns_isp_in1_inf

LDFLAGS += -lfuse3 -lrpc_fs -lrpc_proxy

LDFLAGS += -lhal_analyze_time -lmpp_service -ldl

LDFLAGS += -lhal_sysctl -lmpi_sysctl
