/dts-v1/;
#include "../../common/artosyn-kernel.dtsi"
#include "artosyn-memory.dtsi"

&cpu0 {
    /delete-property/ operating-points-v2;
};
&cpu1 {
    /delete-property/ operating-points-v2;
};
&cpu2 {
    /delete-property/ operating-points-v2;
};
&cpu3 {
    /delete-property/ operating-points-v2;
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&vbus_regulator0 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg0_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 4 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&vbus_regulator1 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg1_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 5 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&vbus_regulator2 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg2_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 6 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&usb_otg0 {
	dr_mode = "peripheral";
	vbus-supply = <&vbus_regulator0>;
	status = "okay";
};

&usb_otg1 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator1>;
	status = "okay";
};

&usb_otg2 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator2>;
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&sec_wdt {
    status = "okay";
};

&rtc0 {
	status = "okay";
};

&pwm0 {
	status = "okay";
};

&pwm1 {
	status = "okay";
};

&tzc {
	status = "disabled";
};

&spi0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi0_s {
	status = "disabled";
};

&spi1_s {
	status = "disabled";
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};

&emmc {
//	/delete-property/voltage-ranges;
//	/delete-property/no-1-8-v;
	/delete-property/full-pwr-cycle;
//	mmc-hs200-1_8v;
	status = "okay";
};

&sdmmc {
	clock-frequency = <100000000>;
	clock-freq-min-max = <400000 100000000>;
	num-slots = <3>;
	cap-sdio-irq;
	/delete-property/no-sdio;
	status = "okay";
};

&mdio {
	status = "okay";

	phy0: ethernet-phy@1 {
        compatible = "ethernet-phy-id001c.c816","ethernet-phy-ieee802.3-c22";
		status = "okay";
	};
};

&gmac {
	phy-mode = "rmii";

	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <SPI_NOR_CS0>;
		spi-max-frequency = <150000000>;
	};
	flash@1 {
		compatible = "spi-nand";
		reg = <SPI_NAND_CS0>;
		spi-max-frequency = <150000000>;
	};
	flash@2 {
		compatible = "jedec,spi-nor";
		reg = <SPI_NOR_CS1>;
		spi-max-frequency = <150000000>;
	};
	flash@3 {
		compatible = "spi-nand";
		reg = <SPI_NAND_CS1>;
		spi-max-frequency = <150000000>;
	};
};

&ipsec {
    status = "disabled";
};

&pka {
    status = "disabled";
};

&hwrng {
    status = "disabled";
};

