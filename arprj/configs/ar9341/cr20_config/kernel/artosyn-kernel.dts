/dts-v1/;
#include "../../common/artosyn-kernel.dtsi"
#include "artosyn-memory.dtsi"

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&vbus_regulator0 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg0_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	/delete-property/ gpio;
	enable-active-high;
};

&vbus_regulator1 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg1_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	/delete-property/ gpio;
	enable-active-high;
};

&vbus_regulator2 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg2_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portb1 2 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&usb_otg0 {
	dr_mode = "peripheral";
	vbus-supply = <&vbus_regulator0>;
	status = "okay";
};

&usb_otg1 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator1>;
	status = "okay";
};

&usb_otg2 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator2>;
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&sec_wdt {
    status = "okay";
};

&rtc0 {
	status = "okay";
};

&pwm0 {
	status = "okay";
};

&pwm1 {
	status = "okay";
};

&tzc {
	status = "disabled";
};

&spi0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi0_s {
	status = "disabled";
};

&spi1_s {
	status = "disabled";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
	Goodix-TS@14 {
		status = "okay";
		compatible = "goodix,gt1x";
		reg = <0x14>;
		interrupt-parent = <&porta3>;
		interrupts = <5 IRQ_TYPE_EDGE_FALLING>;
		//interrupts = <13 IRQ_TYPE_EDGE_FALLING>;
		goodix,reset-gpio = <&portb1 7 GPIO_ACTIVE_HIGH>;
		goodix,irq-gpio = <&porta3 5 IRQ_TYPE_EDGE_FALLING>;
		irq-flags = <2>;
		touchscreen-max-id = <11>;
		touchscreen-size-x = <720>;
		touchscreen-size-y = <1440>;
		touchscreen-max-w = <512>;
		touchscreen-max-p = <512>;
		touchscreen-key-map = <172>, <158>; /*KEY_HOMEPAGE=172, KEY_BACK=158��KEY_MENU=139*/
		goodix,slide-wakeup = <0>;
		goodix,type-a-report = <0>;
		goodix,driver-send-cfg = <0>;
		goodix,resume-in-workqueue = <0>;
		goodix,int-sync = <1>;
		goodix,swap-x2y = <0>;
		goodix,esd-protect = <1>;
		goodix,auto-update-cfg = <0>;
		goodix,power-off-sleep = <0>;
		goodix,pen-suppress-finger = <0>;
		goodix,cfg-group0 = [
			53 D0 02 00 05 05 F5 D5 21 48 2D 0F 5A 41 0E 05 00 00 32 32 20 00 05 14 14 1A 14 8B 2B 00
		];
	};
};

&i2c4 {
	status = "okay";
};

&emmc {
//	/delete-property/voltage-ranges;
//	/delete-property/no-1-8-v;
	/delete-property/full-pwr-cycle;
//	vqmmc-supply = <&DA9062_LDO4>;
//	mmc-hs200-1_8v;
	status = "okay";
};

&sdmmc {
	/delete-property/ no-sdio;
	cap-sdio-irq;
	/delete-property/ sd-uhs-sdr12;
	/delete-property/ sd-uhs-sdr25;
	/delete-property/ sd-uhs-sdr50;
	/delete-property/ sd-uhs-sdr104;
	#no-sd;
	broken-cd;
	slot-bitmap-fixed-1v8 = <1>;
	status = "okay";
};

&mdio {
	status = "okay";

	phy0: ethernet-phy@1 {
		status = "okay";
	};
};

&gmac {
	mac-address = [00 00 01 02 03 04]; /*This should not be here if uboot has set mac already*/
	phy-mode = "rmii";
	phy-handle = <&phy0>;
	tzc-handle = <&tzc>;
	tx-fifo-depth = <3>;
	tx-fifo-depth-1000 = <2>;
	tx-bd-num = <64>; /*total 128 bds, rx-bd-num = 128 - tx-bd-num*/
	tx-enhance;
	rx-enhance;
	status = "okay";
};

&qspi {
	status = "okay";
};

