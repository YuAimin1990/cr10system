/dts-v1/;
#include "../../common/artosyn-kernel.dtsi"
#include "artosyn-memory.dtsi"

&uart0 {
	status = "okay";
};

&dw_ceva_dmac {
	status = "disabled";
};

&can0 {
	status = "okay";
};

&can1 {
	status = "okay";
};

&can2 {
	status = "okay";
};

&can3 {
	status = "okay";
};

&vbus_regulator0 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg0_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 4 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&vbus_regulator1 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg1_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 5 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&vbus_regulator2 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg2_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 6 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&usb_otg0 {
	dr_mode = "peripheral";
	vbus-supply = <&vbus_regulator0>;
	status = "okay";
};

&usb_otg1 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator1>;
	status = "okay";
};

&usb_otg2 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator2>;
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&sec_wdt {
    status = "okay";
};

&rtc0 {
	status = "okay";
};

&pwm0 {
	status = "okay";
};

&tzc {
	status = "disabled";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "disabled";
};

&emmc {
	status = "okay";
};

&sdmmc {
	status = "disabled";
};

&mdio {
	status = "okay";

	phy0: ethernet-phy@1 {
		status = "okay";
	};
};

&gmac {
	mac-address = [00 00 01 02 03 04]; /*This should not be here if uboot has set mac already*/
	phy-mode = "rgmii";
	phy-handle = <&phy0>;
	tzc-handle = <&tzc>;
	tx-fifo-depth = <3>;
	tx-fifo-depth-1000 = <2>;
	tx-bd-num = <64>; /*total 128 bds, rx-bd-num = 128 - tx-bd-num*/
	tx-enhance;
	rx-enhance;
	status = "okay";
};

&qspi{
	status = "disable";
};
