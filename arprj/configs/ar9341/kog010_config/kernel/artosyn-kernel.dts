//example for dual cpu regulater
&cpu0 {
	cpu-dual-0-supply = <&DA9062_BUCK1>;
	cpu-dual-1-supply = <&DA9062_BUCK2>;
};

&cpu1 {
	cpu-dual-0-supply = <&DA9062_BUCK1>;
	cpu-dual-1-supply = <&DA9062_BUCK2>;
};

&cpu2 {
	cpu-dual-0-supply = <&DA9062_BUCK1>;
	cpu-dual-1-supply = <&DA9062_BUCK2>;
};

&cpu3 {
	cpu-dual-0-supply = <&DA9062_BUCK1>;
	cpu-dual-1-supply = <&DA9062_BUCK2>;
};

&a53_opp_table {

	opp-100000000 {
		opp-hz = /bits/ 64 <100000000>;
		opp-microvolt = <900000>,
				<900000>;
		clock-latency-ns = <150000>;
		opp-suspend;
	};

	opp-200000000 {
		opp-hz = /bits/ 64 <200000000>;
		opp-microvolt = <900000>,
				<900000>;
		clock-latency-ns = <150000>;
	};

	opp-400000000 {
		opp-hz = /bits/ 64 <400000000>;
		opp-microvolt = <900000>,
				<900000>;
		clock-latency-ns = <150000>;
	};

	opp-800000000 {
		opp-hz = /bits/ 64 <800000000>;
		opp-microvolt = <900000>,
				<900000>;
		clock-latency-ns = <150000>;
	};

	opp-900000000 {
		opp-hz = /bits/ 64 <900000000>;
		opp-microvolt = <900000>,
				<900000>;
		clock-latency-ns = <150000>;
	};

#if 0
	//just for cpu overclock
	opp-1000000000 {
		opp-hz = /bits/ 64 <1000000000>;
		opp-microvolt = <900000>,
				<900000>;
		clock-latency-ns = <150000>;
	};

	opp-1100000000 {
		opp-hz = /bits/ 64 <1100000000>;
		opp-microvolt = <950000>,
				<950000>;
		clock-latency-ns = <150000>;
		//turbo-mode;
	};

	opp-1200000000 {
		opp-hz = /bits/ 64 <1200000000>;
		opp-microvolt = <1000000>,
				<1000000>;
		clock-latency-ns = <150000>;
		//turbo-mode;
	};

	opp-1300000000 {
		opp-hz = /bits/ 64 <1300000000>;
		opp-microvolt = <1050000>,
				<1050000>;
		clock-latency-ns = <150000>;
		//turbo-mode;
	};
#endif
};
&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&uart2 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&vbus_regulator0 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg0_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 4 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

&vbus_regulator1 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg1_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 5 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};

/*
&vbus_regulator2 {
	compatible = "regulator-fixed";
	regulator-name = "usb_otg2_vbus";
	regulator-min-microvolt = <5000000>;
	regulator-max-microvolt = <5000000>;
	gpio = <&portd1 6 GPIO_ACTIVE_HIGH>;
	enable-active-high;
};
*/

&usb_otg0 {
	dr_mode = "peripheral";
	vbus-supply = <&vbus_regulator0>;
	status = "okay";
};

&usb_otg1 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator1>;
	status = "okay";
};

&usb_otg2 {
	dr_mode = "host";
	vbus-supply = <&vbus_regulator2>;
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&sec_wdt {
    status = "okay";
};

&rtc0 {
	status = "okay";
};

&pwm0 {
	status = "okay";
};

&pwm1 {
	status = "okay";
};

&tzc {
	status = "disabled";
};

&spi0 {
	status = "disabled";
};

&spi1 {
	status = "okay";
#ifdef AR_FEAT_EIS
	num-cs = <2>;
	cs-gpios = <&portb3 3 0>,
				<&porta3 0 0>;
	spidev00: spidev00 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "spidev";
		reg = <0>;
		spi-cs-high;
		spi-max-frequency = <20000000>;
	};
	mpu0_spi: mpu6509 {
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "tdk,mpu6509";
		reg = <1>;
		spi-max-frequency = <20000000>;
		interrupt-parent = <&porta1>;
		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
	};
#else
    num-cs = <1>;
    cs-gpios = <&portb3 3 0>;
    //status = "disabled";
    spidev00: spidev00 {
        #address-cells = <1>;
        #size-cells = <1>;
        compatible = "spidev";
        reg = <0>;
        spi-max-frequency = <20000000>;
    };
#endif
};

&spi0_s {
	status = "disabled";
};

&spi1_s {
	status = "disabled";
};

&i2c0 {
	status = "okay";

	pmic0: da9062@58 {
		status = "okay";
		compatible = "dlg,da9062";
		reg = <0x58>;
		interrupt-parent = <&porta2>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		//gpios = <&portc1 6 GPIO_ACTIVE_LOW>;

		rtc {
			compatible = "dlg,da9062-rtc";
		};

		watchdog {
			compatible = "dlg,da9062-watchdog";
		};

		thermal {
			compatible = "dlg,da9062-thermal";
			polling-delay-passive = <3000>;
		};

		regulators {
			DA9062_BUCK1: buck1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1570000>;
				regulator-min-microamp = <500000>;
				regulator-max-microamp = <2000000>;
				regulator-boot-on;
			};
			DA9062_BUCK2: buck2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1570000>;
				regulator-min-microamp = <500000>;
				regulator-max-microamp = <2000000>;
				regulator-boot-on;
			};
			DA9062_LDO3: ldo3 {
				regulator-name = "LDO_3";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};
			DA9062_LDO4: ldo4 {
				regulator-name = "LDO_4";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
			};
		};
	};
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";

	mpu0_i2c: mpu6509@68 {
		status = "okay";
		compatible = "tdk,mpu6509";
		reg = <0x68>;
		interrupt-parent = <&porta1>;
		interrupts = <0 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
	};
};

&i2c3 {
	status = "okay";
	 Goodix_TS@5d {
        status = "okay";
        compatible = "goodix,gt9xx";
        reg = <0x5d>;
        interrupts = <13 0x2800>;
        
        reset-gpios = <&portd1 6 GPIO_ACTIVE_HIGH>;
        irq-gpios = <&porta3 5 GPIO_ACTIVE_HIGH>;
        irq-flags = <2>;
        
        touchscreen-size-y = <720>;
        touchscreen-size-x = <1280>;
        goodix,swap-x2y = <1>;
        goodix,int-sync = <1>;
        goodix,auto-update-cfg = <0>;
        goodix,driver-send-cfg = <0>;
        goodix,esd-protect = <1>;
        touchscreen-key-map = <12>;

        goodix,cfg-group5 = [
            62 00 05 D0 02 01 3D 00 12 0A 28 0F 5A 3C 03 08 00 00 00 00 02 00 08 17 19 1D 14 89 29 0A 46 48 B2 04 00 00 00 02 02 11 19 01 00 00 00 00 00 00 00 00 00 28 5A 94 D5 02 08 00 00 04 C8 2B 00 AA 33 00 93 3C 00 80 46 00 6D 53 00 6D 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 14 12 10 0E 0C 0A 08 06 04 02 FF FF FF FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 22 21 20 1F 1E 1D 1C 18 16 00 02 04 06 08 0A 0F 10 12 FF FF FF FF FF FF FF FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 B8 01
        ];
        goodix,cfg-group8 = [
            62 00 05 20 03 01 3D 00 02 08 1E 0A 55 3C 03 08 00 00 00 00 02 00 07 18 1A 20 13 8C 2B 0D 39 3B B2 04 00 00 00 01 03 1D 00 01 00 00 00 00 00 00 00 00 00 28 5A 94 D5 02 08 00 00 00 A2 2B 00 8C 33 00 7A 3C 00 6C 46 00 5F 53 00 5F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 1A 18 16 14 12 10 0E 0C 0A 08 06 04 02 FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 04 06 08 0A 0C 0F 10 12 13 14 16 18 1C 1D 1E 1F 20 21 22 24 26 FF FF FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 6D 01
        ];
        goodix,cfg-group7 = [
            5D D0 02 00 05 05 70 20 02 0A 1E 0F 5A 3C 03 05 00 00 00 00 00 00 06 17 19 1C 14 87 28 0A 28 2D C1 0E 00 00 01 03 02 2D 00 21 00 00 00 00 00 00 00 00 00 1C 41 94 D5 02 07 00 00 04 A3 1E 00 8B 24 00 7A 2A 00 6A 32 00 5D 3B 00 5D 00 00 00 00 F7 50 40 FF FF 27 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 04 06 08 0A 0C 0E 10 12 14 FF FF FF FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 26 24 22 21 20 1F 1E 1D 0C 0A 08 06 04 02 00 FF FF FF FF FF FF FF FF FF FF FF 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 15 01
        ];
        goodix,cfg-group10 = [
            41 20 03 00 05 05 05 00 01 08 28 05 50 32 03 05 00 00 00 00 00 00 00 00 00 00 00 90 30 AA 14 12 12 0C 00 00 01 9B 03 1D 00 00 00 00 00 03 00 00 00 00 00 12 46 94 C5 02 07 00 00 04 7B 14 00 71 1B 00 68 23 00 60 2F 00 5B 3D 00 5B 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 04 05 06 07 08 09 0C 0D 0E 0F 10 11 14 15 16 17 18 19 FF FF FF FF 00 00 00 00 00 00 2A 29 28 27 26 25 24 23 22 21 20 1F 1E 1C 1B 19 00 02 04 06 07 08 0A 0C 0D 0E 0F 10 11 12 13 14 00 00 00 00 00 00 00 00 00 00 9F 01
        ];
    };
};

&i2c4 {
	status = "okay";
};

&emmc {
//	/delete-property/voltage-ranges;
//	/delete-property/no-1-8-v;
	/delete-property/full-pwr-cycle;
//	vqmmc-supply = <&DA9062_LDO4>;
//	mmc-hs200-1_8v;
	status = "okay";
};

&sdmmc {
	clock-frequency = <100000000>;
	clock-freq-min-max = <400000 100000000>;
	vqmmc-supply = <&DA9062_LDO3>;
	num-slots = <3>;
	cap-sdio-irq;
	/delete-property/no-sdio;
	status = "okay";
};

&mdio {
	status = "okay";

	phy0: ethernet-phy@1 {
		status = "okay";
	};
};

&gmac {
	mac-address = [00 00 01 02 03 04]; /*This should not be here if uboot has set mac already*/
	phy-mode = "rmii";
	phy-handle = <&phy0>;
	tzc-handle = <&tzc>;
	tx-fifo-depth = <3>;
	tx-fifo-depth-1000 = <2>;
	tx-bd-num = <64>; /*total 128 bds, rx-bd-num = 128 - tx-bd-num*/
	tx-enhance;
	rx-enhance;
	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <SPI_NOR_CS0>;
		spi-max-frequency = <150000000>;
	};
	flash@1 {
		compatible = "spi-nand";
		reg = <SPI_NAND_CS0>;
		spi-max-frequency = <150000000>;
	};
	flash@2 {
		compatible = "jedec,spi-nor";
		reg = <SPI_NOR_CS1>;
		spi-max-frequency = <150000000>;
	};
	flash@3 {
		compatible = "spi-nand";
		reg = <SPI_NAND_CS1>;
		spi-max-frequency = <150000000>;
	};
};

