/ {
	test_pwm {
		compatible = "artosyn,test-pwm";
		pwms =  <&pwm0 0 1000000000>,
			<&pwm0 1 1000000000>,
			<&pwm0 2 1000000000>,
			<&pwm0 3 1000000000>,
			<&pwm0 4 1000000000>,
			<&pwm0 5 1000000000>,
			<&pwm0 6 1000000000>,
			<&pwm0 7 1000000000>,
			<&pwm1 0 1000000000>,
			<&pwm1 1 1000000000>;
		pwm-names = 	"pwm0", "pwm1", "pwm2", "pwm3", "pwm4",
				"pwm5", "pwm6", "pwm7", "pwm8", "pwm9";
	};
};

