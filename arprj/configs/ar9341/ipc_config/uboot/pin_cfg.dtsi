                (PB_MSC_BIT1 | PB_MSC_REG_PIN_V18)  // PB093_098
                (PB_MSC_BIT2 | PB_MSC_REG_PIN_V18)  // PB102_107
                (PB_MSC_BIT3 | PB_MSC_REG_PIN_V33)  // PB111_116
                (PB_MSC_BIT4 | PB_MSC_REG_PIN_V33)  // PB117_121
                (PB_MSC_BIT5 | PB_MSC_REG_PIN_V33)  // PB002_025
                (PB_MSC_BIT6 | PB_MSC_REG_PIN_V18)  // PB026_049
                (PB_MSC_BIT7 | PB_MSC_REG_PIN_V18)  // PB050_081
                (PB_MSC_BIT8 | PB_MSC_REG_PIN_V33)  // PB082_083, PB140_143
                (PB_MSC_BIT9 | PB_MSC_REG_PIN_V33)  // PB084, PB087_088, PB099_101, PB108_110, PB122_139, PB144_174, PB192
                (PB_MSC_BIT10 | PB_MSC_REG_PIN_V33)  // PB175_191
        >;
