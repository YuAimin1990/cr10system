/dts-v1/;
#include "../../common/artosyn-kernel.dtsi"
#include "artosyn-memory.dtsi"

/ {
    ar_mpp {
        h26x {
            conf_file_path = "/usrdata/cfg/codec_factory_cfg.cjson";
        };
    };
};



&cpu0 {
    /delete-property/ operating-points-v2;
};
&cpu1 {
    /delete-property/ operating-points-v2;
};

&cpus {
    /delete-node/ cpu@2;
    /delete-node/ cpu@3;
};

&pmu0 {
	interrupts = <GIC_SPI 9  IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 10 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-affinity = <&cpu0>, <&cpu1>;
};

&uart0 {
	status = "okay";
};

&vbus_regulator0 {
	/delete-property/ gpio;
};

&vbus_regulator1 {
	/delete-property/ gpio;
};

&vbus_regulator2 {
	/delete-property/ gpio;
};

&usb_otg0 {
	dr_mode = "peripheral";
    // for uvc isoc
    g-rx-fifo-size = <384>;
	g-tx-fifo-size = <512 512 256 256 256 256 128 128 128 64>;

	status = "okay";
};

&wdt0 {
	status = "okay";
};

&rtc0 {
	status = "disabled";
};

&pwm0 {
	status = "okay";
};

&pwm1 {
	status = "okay";
};

&i2c0 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&i2c2 {
	status = "okay";
};

&i2c3 {
	status = "okay";
};

&i2c4 {
	status = "okay";
};

&qspi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <SPI_NAND_CS0>;
		spi-max-frequency = <150000000>;
	};

    /delete-node/flash@1;
    /delete-node/flash@2;
    /delete-node/flash@3;
};

